# Copia este archivo a .env (cp .env.example .env). NUNCA subas el .env al repositorio.

# Qué banco usa la app:
#   fakes    -> datos de ejemplo de fixtures/ (funciona hoy, por defecto)
#   simulado -> banco simulado de la Persona 1 (banco/simulado.py)
#   api      -> API REST de Belo (banco/belo_api.py), cuando lleguen credenciales
#   mcp      -> servidor MCP de Belo (banco/belo_mcp.py), cuando llegue el acceso
BANCO_MODO=fakes

# URL base y llave de la API de Belo (solo para BANCO_MODO=api)
BELO_API_URL=
BELO_API_KEY=

# URL del servidor MCP de Belo (solo para BANCO_MODO=mcp)
BELO_MCP_URL=

# Quién redacta las explicaciones: "plantillas" (por defecto, sin internet),
# "deepseek" (usa DEEPSEEK_API_KEY) o el nombre de otro proveedor. La IA nunca cambia montos.
IA_PROVEEDOR=plantillas
# Llave del proveedor de IA (vacía si IA_PROVEEDOR=plantillas)
IA_API_KEY=

# DeepSeek (para tareas agénticas y explicaciones cuando IA_PROVEEDOR=deepseek)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Pipeline de datos TRM (API Socrata / datos.gov.co)
# Token opcional para evitar throttling en https://www.datos.gov.co/resource/32sa-8pi3.json
SOCRATA_APP_TOKEN=
SOCRATA_DATASET_ID=32sa-8pi3
SOCRATA_CACHE_PATH=banco/datos/trm_cache.json

# Mandatos firmados estilo AP2 (Idea 3: doble llave)
# En desarrollo/simulado puede quedar vacío (usa secreto efímero de dev) o definirse aquí.
MANDATO_SECRET_KEY=
